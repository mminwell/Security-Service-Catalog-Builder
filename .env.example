# Leave both values empty to run Interactive Demo Mode.
# The catalog then lives in this browser (localStorage) with sample workspaces.
# Nothing is sent to a server.
#
# To use your own Supabase project, paste the Project URL and the anon public key.
# Do not put the service-role key in this file or anywhere in the client.
# Set these in the host's environment (for example Vercel) before the build.
# Next.js inlines NEXT_PUBLIC_* values at build time.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
