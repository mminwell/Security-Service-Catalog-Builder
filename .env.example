# Required before the app can sign anyone in.
# Copy this file to .env.local on your machine. .env.local is gitignored.
# Next.js inlines NEXT_PUBLIC_* values at build time, so set them before `npm run build`
# and before a Vercel deploy. A build without them shows a not-configured screen.
#
# Use the project URL and the anon public key, or the newer publishable key
# (sb_publishable_...). Put that value in NEXT_PUBLIC_SUPABASE_ANON_KEY.
# Do not put the service-role key or the secret key in this file, in git, or in any
# NEXT_PUBLIC_ variable.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
